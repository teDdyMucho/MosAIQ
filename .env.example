# RavMizAI — Supabase credentials
#
# Copy this file to `.env` and fill in the two values from your Supabase
# project: Settings -> API.
#
#   cp .env.example .env
#
# Then generate assets/supabase-config.js from it:
#
#   node build-config.js
#
# `.env` is listed in .gitignore and must never be committed.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The "anon / public" key (NOT the service_role key).
#
# This key is PUBLIC by design: it is compiled into the page and every visitor
# can read it. That is safe only because Row Level Security is enabled on every
# table (see sql/001_schema.sql), which limits it to the signed-in user's own
# rows.
#
# The service_role key bypasses RLS entirely. It must never appear in this file,
# in the browser, or anywhere a visitor could reach it.
SUPABASE_ANON_KEY=
